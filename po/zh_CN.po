msgid "Windows Applications"
msgstr "Windows 应用"

msgid "Create an environment for each application, or reuse one for related programs."
msgstr "为每个应用创建独立环境，相关程序也可以共用同一个环境。"

msgid "Environment"
msgstr "运行环境"

msgid "Environment or application name"
msgstr "环境或应用名称"

msgid "Create environment"
msgstr "创建环境"

msgid "Select an EXE or MSI file"
msgstr "选择 EXE 或 MSI 文件"

msgid "Browse…"
msgstr "浏览…"

msgid "Install / Run"
msgstr "安装 / 运行"

msgid "Add to launcher"
msgstr "添加到启动器"

msgid "Create or select an environment first."
msgstr "请先创建或选择运行环境。"

msgid "Wine settings"
msgstr "Wine 设置"

msgid "Uninstall programs"
msgstr "卸载程序"

msgid "Stop environment"
msgstr "停止环境"

msgid "Could not stop the environment."
msgstr "无法停止运行环境。"

msgid "Stop requested."
msgstr "已请求停止。"

msgid "Could not start the Wine helper."
msgstr "无法启动 Wine 运行工具。"

msgid "Registered applications"
msgstr "已注册的应用"

msgid "Launch"
msgstr "启动"

msgid "Ready"
msgstr "就绪"

msgid "Open logs"
msgstr "打开日志"

msgid "Close Windows applications or stop the environment before closing this window."
msgstr "请先关闭 Windows 应用或停止运行环境，再关闭此窗口。"

msgid "Could not read Wine environments."
msgstr "无法读取 Wine 运行环境。"

msgid "Wine is not installed. Install the Wine runtime packages to continue."
msgstr "尚未安装 Wine，请先安装 Wine 运行依赖。"

msgid "An operation is already running."
msgstr "已有操作正在执行。"

msgid "Working…"
msgstr "正在处理…"

msgid "Operation failed. See the details and logs."
msgstr "操作失败，请查看详情和日志。"

msgid "Finished"
msgstr "已完成"

msgid "Windows applications"
msgstr "Windows 应用"

msgid "Select an environment, then choose Install / Run."
msgstr "选择运行环境，然后点击“安装 / 运行”。"

msgid "Environments"
msgstr "环境管理"

msgid "Logs"
msgstr "日志"

msgid "Application name"
msgstr "应用名称"

msgid "Environment name"
msgstr "环境名称"

msgid "Each environment keeps its own Windows settings and installed programs."
msgstr "每个环境分别保存 Windows 设置和已安装程序。"

msgid "Select an EXE or MSI file and the environment to use."
msgstr "选择 EXE 或 MSI 文件及其运行环境。"

msgid "After installation, select the installed EXE on the Install / Run page, then name it here."
msgstr "安装完成后，在“安装 / 运行”页面选择已安装的 EXE，再在这里为应用命名。"

msgid "Menu"
msgstr "菜单"

msgid "File"
msgstr "文件"

msgid "Quit"
msgstr "退出"

msgid "View"
msgstr "视图"

msgid "Applications"
msgstr "应用"

msgid "Choose an installed EXE to add an application, or edit the selected entry below."
msgstr "选择已安装的 EXE 来添加应用，或编辑下方选中的条目。"

msgid "Installed EXE path"
msgstr "已安装的 EXE 路径"

msgid "Choose EXE…"
msgstr "选择 EXE…"

msgid "Save changes"
msgstr "保存修改"

msgid "Remove launcher entry"
msgstr "移除启动器条目"

msgid "Undo removal"
msgstr "撤销移除"

msgid "Removing an entry keeps the installed program and its environment."
msgstr "移除条目会保留已安装程序及其运行环境。"

msgid "Rename environment"
msgstr "重命名环境"

msgid "Open environment folder"
msgstr "打开环境目录"

msgid "No registered application selected"
msgstr "未选择已注册应用"

msgid "Refresh"
msgstr "刷新"

msgid "Ready to run Windows applications"
msgstr "环境已初始化，可以运行 Windows 应用"

msgid "This environment will be initialized on first use."
msgstr "此环境将在首次使用时初始化。"

msgid "Create an environment to get started."
msgstr "请先创建运行环境。"

msgid "Read environment log"
msgstr "读取环境日志"

msgid "Select an application…"
msgstr "选择应用…"

msgid "Could not start the Windows application. See the details below."
msgstr "无法启动 Windows 应用，请查看下方详情。"
